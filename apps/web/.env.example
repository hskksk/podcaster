# Next.js only auto-loads env files in this directory.

# Storage:
#   local  — write content/ on disk. Default for `pnpm web:dev`.
#   github — GitHub API. Automatic on Vercel (NEXT_PUBLIC_VERCEL_ENV).
# NEXT_PUBLIC_KEYSTATIC_STORAGE=local

# Optional override for local storage root (directory that contains content/).
# KEYSTATIC_LOCAL_BASE=/app

# Optional extra HTTP Basic Auth for /keystatic (user:password).
# GitHub storage already requires GitHub login with repo write access.
# KEYSTATIC_BASIC_AUTH=admin:change-me

# Capture API (POST/PATCH /api/capture). Bearer token, constant-time compare.
# Distinct from Keystatic Basic Auth. Does not call ingest / TTS.
# CAPTURE_API_TOKEN=change-me-to-a-long-random-string
# Contents:write PAT or GitHub App installation token. Vercel / github storage only.
# CAPTURE_GITHUB_TOKEN=
# CAPTURE_GITHUB_BRANCH=main

# GitHub storage (required on Vercel). Create via `pnpm web:github` then /keystatic.
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=
# NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
