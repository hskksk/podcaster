# Next.js only auto-loads env files in this directory.

# Capture storage (local disk vs GitHub API):
#   local  — write under CONTENT_ROOT on disk. Default for `pnpm web:dev`.
#   github — GitHub Contents API. Automatic on Vercel (NEXT_PUBLIC_VERCEL_ENV).
# CAPTURE_STORAGE=local
# NEXT_PUBLIC_CONTENT_STORAGE=local

# Capture API (POST/PATCH /api/capture). Bearer token, constant-time compare.
# Does not call ingest / TTS.
# CAPTURE_API_TOKEN=change-me-to-a-long-random-string
# Contents:write PAT or fine-grained token. Vercel / github storage only.
# CAPTURE_GITHUB_TOKEN=
# CAPTURE_GITHUB_BRANCH=main
# CAPTURE_GITHUB_REPO=hskksk/knowledges

# Public site. Audio players + RSS + Pages redirects.
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
# SUPABASE_PROJECT_REF=
# SUPABASE_SERVICE_ROLE_KEY=