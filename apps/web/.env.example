# Next.js only auto-loads env files in this directory.

# local (default): read/write repo-root content/. Works on a long-running
# host (local, Railway). Ephemeral/read-only hosts (Vercel, Netlify) cannot
# persist local writes.
# github: Keystatic talks to the GitHub API. Required for Vercel/Netlify.
NEXT_PUBLIC_KEYSTATIC_STORAGE=local

# Optional override for local storage root (directory that contains content/).
# KEYSTATIC_LOCAL_BASE=/app

# Optional HTTP Basic Auth for /keystatic (user:password).
# KEYSTATIC_BASIC_AUTH=admin:change-me

# GitHub storage only. Create the GitHub App from a local `pnpm web:dev`
# session with NEXT_PUBLIC_KEYSTATIC_STORAGE=github, then copy these:
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=
# NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
