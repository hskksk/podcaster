{
  "name": "@podcaster/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "prebuild": "pnpm --dir ../.. knowledge:checkout && pnpm --filter @hskksk/markdoc-react build",
    "build": "next build",
    "postbuild": "node scripts/pagefind-index.mjs",
    "start": "next start --hostname 0.0.0.0 --port ${PORT:-3000}",
    "typecheck": "next typegen && tsc --noEmit",
    "markdoc:check-config": "tsx scripts/markdoc-site-config-check.ts",
    "markdoc:check-juken": "tsx scripts/juken-markdoc-check.ts",
    "juken:check-drills": "tsx scripts/juken-drills-check.ts",
    "juken:check-history-map": "tsx scripts/juken-history-map-check.ts",
    "juken:drills-stats": "tsx scripts/juken-drills-stats.ts"
  },
  "dependencies": {
    "@hskksk/markdoc-react": "workspace:*",
    "@keystatic/core": "^0.6.10",
    "@markdoc/markdoc": "^0.5.13",
    "@markdoc/next.js": "^0.7.0",
    "@octokit/rest": "^22.0.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@terrastruct/d2": "0.1.33",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "js-yaml": "^4.3.2",
    "lucide-react": "^1.74.0",
    "mermaid": "11",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shiki": "^4.6.0",
    "tailwindcss": "^4.3.5"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pagefind": "^1.6.0",
    "postcss": "^8.5.33",
    "typescript": "^7.0.2"
  }
}
