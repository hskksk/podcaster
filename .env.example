# --- Supabase (local dev: set automatically by `supabase start`) ---
SUPABASE_URL=http://127.0.0.1:54331
# Public-facing URL for feed.xml and audio links (overrides Docker-internal http://kong:8000 in local dev)
PODCAST_PUBLIC_URL=http://127.0.0.1:54331
SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# --- AI API Keys ---
GEMINI_API_KEY=<your-gemini-api-key>
MEM_API_KEY=<your-mem-api-key>

# --- Pipeline security ---
# HMAC-SHA256 secret for the /ingest webhook.
# Leave empty to disable signature verification during local development.
INGEST_WEBHOOK_SECRET=

# --- Deployment (production only) ---
SUPABASE_PROJECT_REF=<your-project-ref>
# Set after `supabase start` shows the function URL
APP_FUNCTIONS_URL=https://<project-ref>.supabase.co/functions/v1
APP_SERVICE_KEY=<your-service-role-key>
