# AI API Keys (required for both local dev and production)
GEMINI_API_KEY=<your-gemini-api-key>
MEM_API_KEY=<your-mem-api-key>

# Gemini mock (local dev only)
# Set true to bypass real Gemini API calls in Edge Functions.
GEMINI_MOCK_ENABLED=false
# Absolute path recommended when using supabase functions serve.
# Example: /Users/you/prj/podcaster/dev.gemini.mock.toml
GEMINI_MOCK_CONFIG_PATH=
