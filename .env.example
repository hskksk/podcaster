# AI API Keys (required for both local dev and production)
GEMINI_API_KEY=<your-gemini-api-key>
# MEM_API_KEY is unused on the mainline (Phase 6). mem_note_id columns remain as history.

# Capture API (Phase 2). Clip to Git only — never starts TTS.
# Copy CAPTURE_API_TOKEN into apps/web/.env.local as well (`pnpm web:dev`).
CAPTURE_API_TOKEN=<random-long-token>
CAPTURE_API_URL=http://127.0.0.1:3000
# MCP reads (contents:read). Never give MCP a write GITHUB_TOKEN.
# GITHUB_READ_TOKEN=
# Server-only on Vercel (Contents: write). Distinct from Keystatic OAuth secrets.
# CAPTURE_GITHUB_TOKEN=
# CAPTURE_GITHUB_BRANCH=main
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
# SUPABASE_PROJECT_REF=
# SUPABASE_SERVICE_ROLE_KEY=
# Remote scripts (events:backfill, pipeline:*): DATABASE_URL (Session pooler from Connect) is most reliable.
# Or SUPABASE_DB_PASSWORD + `supabase link --project-ref <ref>` (writes supabase/.temp/pooler-url).
# Optional: SUPABASE_ACCESS_TOKEN if pooler-url is missing (Management API).
# SUPABASE_DB_PASSWORD=

# Keystatic (apps/web). Next.js only auto-loads env from apps/web/.env*.
# Copy this value into apps/web/.env.local for `pnpm web:dev`.
# Inlined into the admin UI bundle (not a secret).
NEXT_PUBLIC_KEYSTATIC_STORAGE=local

# Gemini mock server (optional)
# Used only by `pnpm gemini:mock:serve`.
GEMINI_MOCK_PORT=8099
# Optional path override for mock settings TOML.
# Example: /Users/you/prj/podcaster/dev.gemini.mock.toml
GEMINI_MOCK_CONFIG_PATH=

# Local Edge Functions (events pipeline): direct Postgres for domain event append.
# Use host.docker.internal — Edge runs in Docker and cannot use 127.0.0.1:54322.
# Example (adjust from `supabase status -o json` → DB_URL):
# DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres

# Audio transcode (Cloud Run Jobs). See infra/gcp/audio-transcode/README.md §3.
# Terraform project_id → TFC workspace variable (not Sensitive). Same values for Edge Secrets in Dashboard:
# GCP_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'  # invoker SA key, one line, single-quoted
# GCP_PROJECT_ID=            # required when transcode enabled (or project_id inside SA JSON)
# GCP_REGION=asia-northeast1
# GCP_RUN_JOB_NAME=audio-transcode
