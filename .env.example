# AI API Keys (required for both local dev and production)
GEMINI_API_KEY=<your-gemini-api-key>
MEM_API_KEY=<your-mem-api-key>

# Capture API (Phase 2). Clip to Git only — never starts TTS.
# Copy CAPTURE_API_TOKEN into apps/web/.env.local as well (`pnpm web:dev`).
CAPTURE_API_TOKEN=<random-long-token>
CAPTURE_API_URL=http://127.0.0.1:3000
# MCP reads (contents:read). Never give MCP a write GITHUB_TOKEN.
# GITHUB_READ_TOKEN=
# Server-only on Vercel (Contents: write). Distinct from Keystatic OAuth secrets.
# CAPTURE_GITHUB_TOKEN=
# CAPTURE_GITHUB_BRANCH=main
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
# SUPABASE_PROJECT_REF=
# SUPABASE_SERVICE_ROLE_KEY=

# Keystatic (apps/web). Next.js only auto-loads env from apps/web/.env*.
# Copy this value into apps/web/.env.local for `pnpm web:dev`.
# Inlined into the admin UI bundle (not a secret).
NEXT_PUBLIC_KEYSTATIC_STORAGE=local

# Gemini mock server (optional)
# Used only by `pnpm gemini:mock:serve`.
GEMINI_MOCK_PORT=8099
# Optional path override for mock settings TOML.
# Example: /Users/you/prj/podcaster/dev.gemini.mock.toml
GEMINI_MOCK_CONFIG_PATH=
